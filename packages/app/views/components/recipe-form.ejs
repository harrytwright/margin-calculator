<!-- Recipe Form Modal Content -->
<div class="max-h-[80vh] flex flex-col w-full">
  <!-- Modal Header -->
  <div class="flex items-center justify-between px-4 sm:px-6 py-3 sm:py-4 border-b border-gray-200 dark:border-gray-700">
    <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
      <%= recipe ? 'Edit Recipe' : 'Add New Recipe' %>
    </h3>
    <button
      onclick="closeModal()"
      class="w-8 h-8 flex items-center justify-center rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 text-gray-500 dark:text-gray-400 transition-colors"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <form
    hx-<%= recipe ? 'put' : 'post' %>="/recipes<%= recipe ? '/' + recipe.slug : '' %>"
    hx-target="#recipes-editor"
    hx-swap="innerHTML"
    class="flex-1 overflow-y-auto"
  >
    <div class="p-4 sm:p-6 space-y-4">
    <!-- Name -->
    <div>
      <label for="name" class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-2">
        Recipe Name <span class="text-red-500">*</span>
      </label>
      <input
        type="text"
        id="name"
        name="name"
        value="<%= recipe ? recipe.name : '' %>"
        required
        class="w-full h-10 px-3 rounded-lg bg-gray-100 dark:bg-gray-700 border-0 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:ring-2 focus:ring-blue-500"
        placeholder="e.g., Margherita Pizza, Caesar Salad"
      />
    </div>

    <!-- Category & Class Row -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <!-- Category -->
      <div>
        <label for="category" class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-2">
          Category
        </label>
        <input
          type="text"
          id="category"
          name="category"
          value="<%= recipe ? (recipe.category || '') : '' %>"
          class="w-full h-10 px-3 rounded-lg bg-gray-100 dark:bg-gray-700 border-0 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:ring-2 focus:ring-blue-500"
          placeholder="e.g., Pizza, Salad, Dessert"
        />
      </div>

      <!-- Class -->
      <div>
        <label for="class" class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-2">
          Class <span class="text-red-500">*</span>
        </label>
        <select
          id="class"
          name="class"
          required
          class="w-full h-10 px-3 rounded-lg bg-gray-100 dark:bg-gray-700 border-0 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500"
        >
          <option value="menu_item" <%= recipe && recipe.class === 'menu_item' ? 'selected' : '' %>>Menu Item</option>
          <option value="base_template" <%= recipe && recipe.class === 'base_template' ? 'selected' : '' %>>Base Template</option>
          <option value="sub_recipe" <%= recipe && recipe.class === 'sub_recipe' ? 'selected' : '' %>>Sub Recipe</option>
        </select>
      </div>
    </div>

    <!-- Price & Margin Row -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <!-- Sell Price -->
      <div>
        <label for="sellPrice" class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-2">
          Sell Price (pence) <span class="text-red-500">*</span>
        </label>
        <input
          type="number"
          id="sellPrice"
          name="sellPrice"
          value="<%= recipe ? recipe.sellPrice : '' %>"
          required
          min="0"
          step="1"
          class="w-full h-10 px-3 rounded-lg bg-gray-100 dark:bg-gray-700 border-0 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:ring-2 focus:ring-blue-500"
          placeholder="e.g., 850 for £8.50"
        />
      </div>

      <!-- Target Margin -->
      <div>
        <label for="targetMargin" class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-2">
          Target Margin (%)
        </label>
        <input
          type="number"
          id="targetMargin"
          name="targetMargin"
          value="<%= recipe ? (recipe.targetMargin || '') : '' %>"
          min="0"
          max="100"
          step="0.1"
          class="w-full h-10 px-3 rounded-lg bg-gray-100 dark:bg-gray-700 border-0 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:ring-2 focus:ring-blue-500"
          placeholder="e.g., 65"
        />
      </div>
    </div>

    <!-- VAT & Stage Row -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <!-- VAT Checkbox -->
      <div class="flex items-start gap-3 pt-1">
        <input
          type="checkbox"
          id="includesVat"
          name="includesVat"
          value="1"
          <%= recipe && recipe.includesVat === 1 ? 'checked' : 'checked' %>
          class="mt-1 h-4 w-4 rounded border-gray-300 dark:border-gray-600 text-blue-600 focus:ring-blue-500"
        />
        <label for="includesVat" class="text-sm text-gray-700 dark:text-gray-200">
          Price includes VAT
        </label>
      </div>

      <!-- Stage -->
      <div>
        <label for="stage" class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-2">
          Stage
        </label>
        <select
          id="stage"
          name="stage"
          class="w-full h-10 px-3 rounded-lg bg-gray-100 dark:bg-gray-700 border-0 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500"
        >
          <option value="development" <%= recipe && recipe.stage === 'development' ? 'selected' : '' %>>Development</option>
          <option value="active" <%= recipe && recipe.stage === 'active' ? 'selected' : 'selected' %>>Active</option>
          <option value="discontinued" <%= recipe && recipe.stage === 'discontinued' ? 'selected' : '' %>>Discontinued</option>
        </select>
      </div>
    </div>

    <!-- Yield (for sub-recipes) -->
    <div id="yield-fields" class="grid grid-cols-1 sm:grid-cols-2 gap-4" style="display: none;">
      <div>
        <label for="yieldAmount" class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-2">
          Yield Amount
        </label>
        <input
          type="number"
          id="yieldAmount"
          name="yieldAmount"
          value="<%= recipe ? (recipe.yieldAmount || '') : '' %>"
          min="0"
          step="0.01"
          class="w-full h-10 px-3 rounded-lg bg-gray-100 dark:bg-gray-700 border-0 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:ring-2 focus:ring-blue-500"
          placeholder="e.g., 1"
        />
      </div>
      <div>
        <label for="yieldUnit" class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-2">
          Yield Unit
        </label>
        <input
          type="text"
          id="yieldUnit"
          name="yieldUnit"
          value="<%= recipe ? (recipe.yieldUnit || '') : '' %>"
          class="w-full h-10 px-3 rounded-lg bg-gray-100 dark:bg-gray-700 border-0 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:ring-2 focus:ring-blue-500"
          placeholder="e.g., L, kg, portion"
        />
      </div>
    </div>

    <p class="text-xs text-gray-500 dark:text-gray-400 bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-800 rounded p-2">
      <strong>Note:</strong> Ingredient management coming soon! For now, this form creates/updates basic recipe details only.
    </p>
  </div>

  <!-- Modal Footer -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-end gap-3 px-4 sm:px-6 py-3 sm:py-4 border-t border-gray-200 dark:border-gray-700">
      <button
        type="button"
        onclick="closeModal()"
        class="px-4 py-2 text-sm font-medium text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg transition-colors"
      >
        Cancel
      </button>
      <button
        type="submit"
        class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors"
      >
        <%= recipe ? 'Update Recipe' : 'Create Recipe' %>
      </button>
    </div>
  </form>
</div>

<script>
  // Show/hide yield fields based on class selection
  document.getElementById('class')?.addEventListener('change', function() {
    const yieldFields = document.getElementById('yield-fields');
    if (this.value === 'sub_recipe') {
      yieldFields.style.display = 'grid';
    } else {
      yieldFields.style.display = 'none';
    }
  });

  // Trigger on page load
  if (document.getElementById('class')?.value === 'sub_recipe') {
    document.getElementById('yield-fields').style.display = 'grid';
  }

  // Close modal after successful form submission
  document.body.addEventListener('htmx:afterRequest', function(event) {
    if (event.detail.successful && event.target.tagName === 'FORM') {
      closeModal();
      showToast('<%= recipe ? 'Recipe updated successfully' : 'Recipe created successfully' %>', 'success');
    }
  });
</script>
